{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "misub",

  // 钉死兼容性日期，不要交给 wrangler 的「用当天日期」兜底。
  //
  // 兼容性标志是编译进 workerd 二进制的：装的那份 workerd 构建于哪天，
  // 就只认到那之后一小段时间的 compat date。没有本文件时 wrangler 退回当天日期，
  // 二进制放旧几个月后当天日期就越过上限，`wrangler pages dev` 直接起不来：
  //   X [ERROR] This Worker requires compatibility date "<今天>",
  //             but the newest date supported by this server binary is "<上限>".
  // 取值沿用仓库原先在 wrangler-cf-pages.toml 里声明的日期。
  // 若 Cloudflare Pages 面板设的是更新的日期或 "Latest"，改这里与之对齐；
  // 但不得超过当前 workerd 支持的上限，否则本地又起不来。
  "compatibility_date": "2024-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // 本地 KV 绑定。没有它 StorageFactory.resolveKV 返回 null，
  // 整个后端退化成 NoopStorageAdapter：写入静默丢弃、重启即空，
  // 保存/刷新之类的功能在本地根本没法验。
  // id 在 local 模式下只用来定位本地持久化目录，不会去连远端命名空间；
  // 取 "MISUB_KV" 是为了对上历史上用 `--kv MISUB_KV` 跑出来的那份数据，
  // 实际文件在 .wrangler/state/v3/kv/。
  "kv_namespaces": [
    { "binding": "MISUB_KV", "id": "MISUB_KV" }
  ],

  // 本地 D1 绑定。生产已经从 KV 迁到 D1 并删掉了 KV 绑定，本地两个都绑才能
  // 覆盖两条存储路径：默认 storageType 是 'kv'（config.js:35），走
  // POST /api/migrate_to_d1 之后置为 'd1'，与生产一致。
  // 建表是 CREATE TABLE IF NOT EXISTS（storage-adapter.js:21），本地自举，
  // 但只在 DataMigrator 里触发，所以新库要跑一次迁移接口才有表。
  //
  // database_id 是本地占位值，miniflare 只用它定位本地 SQLite 文件。
  // 绝对不要填生产库的真实 UUID（那个在 .wrangler/cf-downloaded-config.toml 里），
  // 填了在某些模式下会去连真库。
  "d1_databases": [
    { "binding": "MISUB_DB", "database_name": "MISUB_DB", "database_id": "MISUB_DB" }
  ]

  // 刻意不写 pages_build_output_dir —— 加上它会让 Cloudflare Pages
  // 把本文件当成生产配置的唯一来源，面板里现有的 KV / D1 绑定与环境变量
  // 将不再合并进部署，上面那个占位 id 也会被当真。
  // 本文件只服务本地开发，生产配置继续以面板为准。
  // 参见 https://developers.cloudflare.com/pages/functions/wrangler-configuration/
  //   "You can continue to use your Wrangler file for local development
  //    without migrating it for production use by not adding a
  //    pages_build_output_dir key."
}
